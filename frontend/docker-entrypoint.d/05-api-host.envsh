#!/bin/sh
# Нормализация API_HOST: https://-адрес значит публичный домен backend (порт 443), иначе приватный host:port (порт 8000 по умолчанию).
# Расширение .envsh, а не .sh: entrypoint образа nginx подключает такие файлы через «.»,
# поэтому export ниже доходит до envsubst, который собирает nginx.conf из шаблона.

API_SCHEME="http"
API_HOST_NAME='$host'

case "${API_HOST}" in
  "")
    echo "ВНИМАНИЕ: API_HOST пуст. Все запросы к /api/ будут отвечать ошибкой." >&2
    echo "  Приватная сеть Railway: API_HOST=<приватный домен backend>:8000" >&2
    echo "  Публичный домен backend: API_HOST=https://<домен backend>.up.railway.app" >&2
    ;;
  *)
    # Схема сравнивается без учёта регистра: HTTPS://… тоже публичный домен.
    scheme=$(printf '%s' "${API_HOST}" | sed -n 's#^\([a-zA-Z][a-zA-Z0-9+.-]*\)://.*#\1#p' | tr 'A-Z' 'a-z')
    if [ "${scheme}" = "https" ]; then
      API_SCHEME="https"
    fi
    stripped=$(printf '%s' "${API_HOST}" | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' -e 's#/*$##')
    case "${stripped}" in
      *:[0-9]*) ;;
      *)
        if [ "${API_SCHEME}" = "https" ]; then
          stripped="${stripped}:443"
        else
          stripped="${stripped}:8000"
        fi
        ;;
    esac
    API_HOST="${stripped}"
    API_HOST_NAME="${stripped%:*}"
    echo "API_HOST=${API_HOST} (схема ${API_SCHEME}, Host ${API_HOST_NAME})"
    ;;
esac

export API_HOST API_SCHEME API_HOST_NAME
