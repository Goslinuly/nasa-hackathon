#!/bin/sh
# Нормализация API_HOST до старта nginx.
#
# Расширение .envsh не случайно: такие файлы entrypoint nginx подключает
# через «.», поэтому экспорт доживает до envsubst и самого nginx. Обычный
# .sh запускается отдельным процессом, и правка переменной была бы потеряна.
#
# Зачем чинить, а не только ругаться: proxy_pass с переменной проверяет URL
# на каждом запросе. Пропущенный порт или лишняя схема превращают адрес в
# «http://host» или «http://https://host», и КАЖДЫЙ запрос к /api/ отвечает
# ошибкой. Снаружи это выглядит как «сломался API», хотя дело в одной строке.
#
# Пустое значение не выдумываем: куда идти — неизвестно, и честнее сказать
# об этом. Запуск при этом не прерываем, статика и тайлы работают без backend.

case "${API_HOST}" in
  "")
    echo "ВНИМАНИЕ: API_HOST пуст. Все запросы к /api/ будут отвечать ошибкой." >&2
    echo "  Задайте переменную фронтенд-сервиса: API_HOST=<host>:<port> backend-а." >&2
    echo "  В Railway: API_HOST=\${{<имя backend-сервиса>.RAILWAY_PRIVATE_DOMAIN}}:8000" >&2
    ;;
  *)
    # Схема здесь лишняя: её подставляет сам шаблон nginx.
    stripped=$(printf '%s' "${API_HOST}" | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' -e 's#/*$##')
    if [ "${stripped}" != "${API_HOST}" ]; then
      echo "API_HOST: убрана схема, осталось '${stripped}'." >&2
    fi

    case "${stripped}" in
      *:[0-9]*) ;;
      *)
        stripped="${stripped}:8000"
        echo "API_HOST без порта — добавлен :8000 ('${stripped}')." >&2
        echo "  Если backend слушает другой порт, задайте его в переменной явно." >&2
        ;;
    esac

    export API_HOST="${stripped}"
    echo "API_HOST=${API_HOST}"
    ;;
esac
