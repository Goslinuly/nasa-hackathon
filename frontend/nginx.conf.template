# Дисковый кэш тайлов: повторный просмотр области берёт картинку локально,
# а не ходит в trek.nasa.gov / Murray Lab заново на каждого зрителя.
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles:16m
                 max_size=1g inactive=30d use_temp_path=off;

server {
  listen ${PORT};
  server_name _;

  # Резолвим upstream в момент запроса, а не на старте: nginx поднимается,
  # даже если backend ещё не задеплоен (до его старта /api отдаёт 502).
  # NGINX_LOCAL_RESOLVERS экспортирует entrypoint образа из /etc/resolv.conf.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # SPA: все маршруты отдаём index.html
  location / {
    try_files $uri /index.html;
  }

  # Хешированные ассеты Vite можно кэшировать надолго
  location /assets/ {
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  # Карта высот MOLA (~4 МБ) лежит под постоянным именем, поэтому immutable
  # сюда не годится: пересобранный рельеф завис бы у пользователей. Кэшируем
  # с обязательной ревалидацией — повторный визит получает 304 вместо 4 МБ.
  location /data/ {
    add_header Cache-Control "public, max-age=0, must-revalidate";
  }

  location /api/ {
    set $api_upstream http://${API_HOST};
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Ошибки самого nginx, а не ответы backend: пустой или содержащий схему
    # API_HOST делает URL в proxy_pass невалидным, и тогда КАЖДЫЙ запрос к /api/
    # получает голый 500 без объяснения. Недостижимый backend даёт 502/504.
    # proxy_intercept_errors выключен по умолчанию, поэтому собственные 5xx
    # backend-а (например, 503 «база недоступна») проходят к клиенту нетронутыми.
    error_page 500 502 504 = @api_unreachable;
  }

  # Ходим сразу в lunaserv, а не в ms-ctx: тот отвечает 302 на http://-адрес,
  # и со страницы по https браузер блокирует переход как mixed content —
  # тайл просто никогда не догружается. Прямой запрос ещё и вдвое быстрее.
  location = /jmars-ctx {
    proxy_pass https://ms-lunaserv.mars.asu.edu/wms;
    proxy_ssl_server_name on;
    proxy_set_header Host ms-lunaserv.mars.asu.edu;
    proxy_read_timeout 45s;
    proxy_cache tiles;
    proxy_cache_valid 200 1d;
    proxy_cache_lock on;
    add_header X-Tile-Cache $upstream_cache_status;
  }

  # Отдаём ошибку в том же формате, что и API, чтобы интерфейс показал причину,
  # а не «HTTP 500».
  location @api_unreachable {
    default_type application/json;
    return 503 '{"error":{"code":"api_unreachable","message":"API недоступен. Проверьте переменную API_HOST фронтенд-сервиса (нужен host:port без http://) и состояние backend."}}';
  }

  # Тайлы NASA Mars Trek: same-origin прокси для WebGL-текстур
  location /trek/ {
    proxy_pass https://trek.nasa.gov/tiles/;
    proxy_ssl_server_name on;
    proxy_set_header Host trek.nasa.gov;
    proxy_buffering on;
    proxy_cache tiles;
    proxy_cache_valid 200 30d;
    # Пробелы покрытия законны: помним и их, чтобы не ходить впустую.
    proxy_cache_valid 404 1h;
    # Один запрос наверх на тайл, даже если его ждут несколько зрителей.
    proxy_cache_lock on;
    # Архивная мозаика не меняется: лучше отдать старый тайл, чем ошибку.
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    add_header X-Tile-Cache $upstream_cache_status;
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  # Глобальная мозаика CTX Murray Lab (5 м/пикс): same-origin прокси для WebGL-текстур
  location /ctx/ {
    proxy_pass https://murray-lab.caltech.edu/CTX/V01/kml/MurrayLab_GlobalCTXMosaic_V01/;
    proxy_ssl_server_name on;
    proxy_set_header Host murray-lab.caltech.edu;
    proxy_buffering on;
    proxy_read_timeout 45s;
    proxy_cache tiles;
    proxy_cache_valid 200 30d;
    proxy_cache_valid 404 1h;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 45s;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    add_header X-Tile-Cache $upstream_cache_status;
    expires 30d;
    add_header Cache-Control "public, immutable";
  }
}
